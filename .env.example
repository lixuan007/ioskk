# Official public-liquidation keeper — copy to .env next to main.py and fill in.
# Loaded from the script directory (not cwd). Never commit real keys. DRY_RUN defaults to true.

# Official public JSON-RPC (no API key). Must be a JSON-RPC gateway, not bnbchain.org / etherscan.
# Paid nodes (dRPC etc.) are optional overrides.
ETH_RPC_URL=https://ethereum.publicnode.com
BNB_RPC_URL=https://bsc-dataseed.binance.org
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# Optional websocket for newHeads (falls back to HTTP poll)
# ETH_WS_URL=
# BNB_WS_URL=

# Operator wallet — YOUR address and key only
EVM_ADDRESS=0xYourOperatorAddress
EVM_PRIVATE_KEY=
SOL_ADDRESS=
SOL_PRIVATE_KEY=

# Telegram (optional). Alerts are fire-and-forget with a 2s timeout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Historical window (empty = live-only). Live continues after history unless END_BLOCK is set
# and LIVE_AFTER_HISTORICAL=false. Official pools/cTokens only — not a dead-contract sweeper.
START_BLOCK=
END_BLOCK=
LIVE_AFTER_HISTORICAL=true

# Prefilter: ignore positions/markets below this collateral USD floor
MIN_USD=2
ETH_USD=3000

# Official pool/cToken native-coin floor before eth_call (ETH on Ethereum, BNB on BNB). Strictly greater than.
MIN_NATIVE=0.05

# Sequential block-order scan (low load). CONCURRENCY is kept for env compat; blocks are not fanned out.
CONCURRENCY=1
LOG_CHUNK_BLOCKS=2000
POLL_INTERVAL_SEC=4
LIVE_LOOKBACK_BLOCKS=3

# Safety: real txs are sent only when DRY_RUN=false AND eth_call simulation succeeded
DRY_RUN=true

LOG_FILE=keeper.log
LOG_LEVEL=INFO

# Optional extra official pools/comptrollers (comma-separated)
# EXTRA_AAVE_POOLS_ETH=
# EXTRA_AAVE_POOLS_BNB=
# EXTRA_COMPOUND_COMPTROLLERS_ETH=
# EXTRA_COMPOUND_COMPTROLLERS_BNB=
